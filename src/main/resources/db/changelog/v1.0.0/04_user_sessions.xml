<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ════════════════════════════════════════════════════
         04 — User sessions table
         Login/session security trail (UserSession entity).
         ════════════════════════════════════════════════════ -->

    <changeSet author="community-dev" id="v1.0.0-04-01">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="user_sessions"/></not>
        </preConditions>
        <createTable tableName="user_sessions">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="user_sessions_pkey"/>
            </column>
            <column name="user_id"          type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="session_id"       type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="ip_address"       type="VARCHAR(64)"/>
            <column name="user_agent"       type="VARCHAR(400)"/>
            <column name="device"           type="VARCHAR(40)"/>
            <column name="browser"          type="VARCHAR(40)"/>
            <column name="login_at"         type="TIMESTAMP WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="last_activity_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="logout_at"        type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="status"           type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="correlation_id"   type="VARCHAR(64)"/>
        </createTable>
    </changeSet>

    <changeSet author="community-dev" id="v1.0.0-04-02">
        <createIndex indexName="idx_session_user" tableName="user_sessions">
            <column name="user_id"/>
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_session_login" tableName="user_sessions">
            <column name="login_at"/>
        </createIndex>
        <createIndex indexName="idx_session_status" tableName="user_sessions">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
