<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ════════════════════════════════════════════════════
         07 — Inventory & Expense Auditing Schema
         ════════════════════════════════════════════════════ -->

    <changeSet author="community-dev" id="v1.0.0-07-01">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="inventory_items"/></not>
        </preConditions>
        <createTable tableName="inventory_items">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="inventory_items_pkey"/>
            </column>
            <column name="name"          type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="category"      type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="status"        type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="original_cost" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="tco"           type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="qr_code_id"    type="VARCHAR(40)">
                <constraints unique="true" uniqueConstraintName="uq_inventory_qr"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="community-dev" id="v1.0.0-07-02">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="inventory_transactions"/></not>
        </preConditions>
        <createTable tableName="inventory_transactions">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="inventory_transactions_pkey"/>
            </column>
            <column name="item_id"            type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_transaction_item" referencedTableName="inventory_items" referencedColumnNames="id"/>
            </column>
            <column name="borrowed_by"        type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="borrowed_by_flat"   type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="borrowed_at"        type="TIMESTAMP WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="expected_return_at" type="VARCHAR(60)">
                <constraints nullable="false"/>
            </column>
            <column name="returned_at"        type="TIMESTAMP WITHOUT TIME ZONE"/>
        </createTable>
    </changeSet>

    <changeSet author="community-dev" id="v1.0.0-07-03">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="invoices"/></not>
        </preConditions>
        <createTable tableName="invoices">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="invoices_pkey"/>
            </column>
            <column name="invoice_number"  type="VARCHAR(60)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_invoice_num"/>
            </column>
            <column name="invoice_date"    type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="vendor_name"     type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount"    type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="status"          type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="uploaded_by"     type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="receipt_url"     type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="approval_notes"  type="VARCHAR(255)"/>
            <column name="upi_id"          type="VARCHAR(64)"/>
            <column name="bank_details"    type="VARCHAR(255)"/>
            <column name="ocr_raw_metadata" type="jsonb"/>
        </createTable>
    </changeSet>

    <changeSet author="community-dev" id="v1.0.0-07-04">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="invoice_line_items"/></not>
        </preConditions>
        <createTable tableName="invoice_line_items">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="invoice_line_items_pkey"/>
            </column>
            <column name="invoice_id"       type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_line_item_invoice" referencedTableName="invoices" referencedColumnNames="id" deleteCascade="true"/>
            </column>
            <column name="item_id"          type="BIGINT">
                <constraints foreignKeyName="fk_line_item_asset" referencedTableName="inventory_items" referencedColumnNames="id"/>
            </column>
            <column name="description"      type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="unit_price"       type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="total_price"      type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="expense_category" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="community-dev" id="v1.0.0-07-05">
        <sql dbms="postgresql">
            CREATE INDEX idx_transactions_active_checkout 
            ON inventory_transactions (expected_return_at) 
            WHERE returned_at IS NULL;
            
            CREATE INDEX idx_line_items_category_price 
            ON invoice_line_items (expense_category, total_price);
        </sql>
    </changeSet>

</databaseChangeLog>
