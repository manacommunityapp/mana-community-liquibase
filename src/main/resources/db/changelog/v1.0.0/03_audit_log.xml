<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ════════════════════════════════════════════════════
         03 — Audit log table
         Durable audit trail (AuditLog entity / AuditService).
         No FK on user_id: audit rows must survive user
         deletion for retention/compliance.
         ════════════════════════════════════════════════════ -->

    <changeSet author="community-dev" id="v1.0.0-03-01">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="audit_log"/></not>
        </preConditions>
        <createTable tableName="audit_log">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="audit_log_pkey"/>
            </column>
            <column name="user_id"        type="BIGINT"/>
            <column name="action"         type="VARCHAR(60)">
                <constraints nullable="false"/>
            </column>
            <column name="module"         type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_name"    type="VARCHAR(60)"/>
            <column name="entity_id"      type="VARCHAR(64)"/>
            <column name="old_value"      type="TEXT"/>
            <column name="new_value"      type="TEXT"/>
            <column name="ip_address"     type="VARCHAR(64)"/>
            <column name="correlation_id" type="VARCHAR(64)"/>
            <column name="created_at"     type="TIMESTAMP WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="community-dev" id="v1.0.0-03-02">
        <createIndex indexName="idx_audit_user" tableName="audit_log">
            <column name="user_id"/>
            <column name="created_at"/>
        </createIndex>
        <createIndex indexName="idx_audit_module" tableName="audit_log">
            <column name="module"/>
            <column name="created_at"/>
        </createIndex>
        <createIndex indexName="idx_audit_action" tableName="audit_log">
            <column name="action"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
